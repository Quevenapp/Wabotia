{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@cloudflare/workers-types", "vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": ["src", "web", "packages", "vite.config.ts"],
  "exclude": [
    "web/erp/test",
    "web/erp/qa",
    "web/erp/app/qa",
    "web/erp/app/qa.tsx",
    "web/erp/app/qa-*.tsx"
  ]
}
