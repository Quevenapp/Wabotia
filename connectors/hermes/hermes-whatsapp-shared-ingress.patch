+@pytest.mark.asyncio
+async def test_cloud_listener_routes_handshake_and_signed_body_to_named_profile(mux_home):
+    import json
+    from aiohttp import ClientSession
+    from hermes_constants import get_hermes_home
+    runner = _Runner({})
+    adapters = await _cloud_pair(runner)
+    seen = []
+
+    async def record(message, contacts, metadata):
+        seen.append((message["id"], Path(get_hermes_home())))
+
+    for adapter in adapters:
+        adapter._ingest_message = record
+    try:
+        for adapter in adapters:
+            assert await adapter.connect()
+        default = adapters[0]
+        port = default._runner.addresses[0][1]
+        async with ClientSession() as client:
+            base = f"http://127.0.0.1:{port}"
+            for path, token, expected in (
+                ("/whatsapp/webhook", "verify-default", 200),
+                ("/p/coder/whatsapp/webhook", "verify-coder", 200),
+                ("/p/ops/whatsapp/webhook", "verify-ops", 200),
+                ("/p/coder/whatsapp/webhook", "verify-default", 403),
+                ("/whatsapp/webhook", "verify-coder", 403),
+                ("/p/default/whatsapp/webhook", "verify-default", 404),
+                ("/p/missing/whatsapp/webhook", "verify-coder", 404),
+            ):
+                async with client.get(base + path, params={"hub.mode": "subscribe",
+                        "hub.verify_token": token, "hub.challenge": "a+b & probe"}) as response:
+                    assert response.status == expected
+                    if expected == 200:
+                        assert await response.text() == "a+b & probe"
+            payload = {"object": "whatsapp_business_account", "entry": [{"id": "waba", "changes": [
+                {"field": "messages", "value": {"metadata": {"phone_number_id": "phone-coder"},
+                 "messages": [{"id": "probe"}]}}]}]}
+            body = json.dumps(payload).encode()
+            for name, expected in (("default", 401), ("ops", 401), ("coder", 200)):
+                sig = hmac.new(f"secret-{name}".encode(), body, hashlib.sha256).hexdigest()
+                async with client.post(base + "/p/coder/whatsapp/webhook", data=body,
+                        headers={"X-Hub-Signature-256": "sha256=" + sig}) as response:
+                    assert response.status == expected
+            assert seen == [("probe", mux_home / "profiles" / "coder")]
+            # Valid signature for a sibling's phone is acknowledged but never ingested.
+            sig = hmac.new(b"secret-ops", body, hashlib.sha256).hexdigest()
+            async with client.post(base + "/p/ops/whatsapp/webhook", data=body,
+                    headers={"X-Hub-Signature-256": "sha256=" + sig}) as response:
+                assert response.status == 200
+            assert len(seen) == 1
+            # Removing a profile or disabling multiplexing must fail closed.
+            runner._profile_adapters.pop("coder")
+            assert (await client.get(base + "/p/coder/whatsapp/webhook")).status == 404
+            runner.config.multiplex_profiles = False
+            assert (await client.get(base + "/p/ops/whatsapp/webhook")).status == 404
+    finally:
+        for adapter in reversed(adapters):
+            await adapter.disconnect()
+
