+async def _cloud_pair(runner):
+    from gateway.platforms.whatsapp_cloud import WhatsAppCloudAdapter
+    adapters = []
+    for name in ("default", "coder", "ops"):
+        adapter = WhatsAppCloudAdapter(PlatformConfig(enabled=True, extra={
+            "phone_number_id": f"phone-{name}", "access_token": f"access-{name}",
+            "app_secret": f"secret-{name}", "verify_token": f"verify-{name}",
+            "webhook_host": "127.0.0.1", "webhook_port": 0,
+        }))
+        adapter.gateway_runner = runner
+        if name != "default":
+            adapter._shared_listener_profile = name
+            adapter.set_owner_profile(name)
+            runner._profile_adapters[name] = {Platform.WHATSAPP_CLOUD: adapter}
+        else:
+            runner.adapters[Platform.WHATSAPP_CLOUD] = adapter
+        adapters.append(adapter)
+    return adapters
+
