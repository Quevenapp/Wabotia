+@pytest.mark.asyncio
+async def test_cloud_listener_is_discovered_only_while_bound(mux_home):
+    from gateway.platforms.shared_ingress import shared_listener_base
+    runner = _Runner({})
+    adapters = await _cloud_pair(runner)
+    default = adapters[0]
+    assert shared_listener_base(runner) is None
+    try:
+        assert await default.connect()
+        # Production uses the configured listening port; zero is only for this ephemeral test.
+        default._webhook_port = default._runner.addresses[0][1]
+        assert shared_listener_base(runner) == f"http://127.0.0.1:{default._webhook_port}"
+    finally:
+        await default.disconnect()
+    assert shared_listener_base(runner) is None
