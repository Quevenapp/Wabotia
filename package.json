{
  "name": "wabotia",
  "version": "0.16.4",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "web": "vite --host 127.0.0.1",
    "build": "node scripts/build-info.mjs && vite build",
    "check": "node scripts/build-info.mjs && tsc --noEmit",
    "pretest": "node scripts/build-info.mjs",
    "test": "vitest run",
    "deploy": "node scripts/deploy.mjs",
    "release": "node scripts/release.mjs",
    "migrate": "wrangler d1 migrations apply DB --remote",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "setup": "node scripts/setup.mjs",
    "format": "prettier --write src web tests scripts *.ts *.json *.jsonc",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "diagnose": "node scripts/diagnose.mjs"
  },
  "dependencies": {
    "hono": "^4.10.0",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.11.0",
    "opus-recorder": "^8.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "unpdf": "^2.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "5.20261104.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.1.0",
    "wrangler": "4.157.0"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "Banco D1 exclusivo desta instalação. Será criado automaticamente."
      },
      "MEDIA": {
        "description": "Bucket R2 privado para arquivos. Habilite R2 na sua conta."
      },
      "MASTER_KEY": {
        "description": "Abra wabotia.queven.app/install#chaves e clique em Gerar minhas duas chaves. Copie MASTER_KEY para cá e guarde: ela protege suas credenciais. Não use sua senha de login."
      },
      "SETUP_TOKEN": {
        "description": "No mesmo gerador, copie SETUP_TOKEN para cá e guarde também. É diferente de MASTER_KEY. Você usará este valor como código de instalação ao criar o primeiro administrador em /app."
      }
    }
  }
}
